# Estágio 1: build do bundle React com Vite.
# NOTA: o build context deve ser a RAIZ do repositório (ver
# docker-compose.prod.yml), pois este Dockerfile referencia tanto o
# código do frontend quanto o nginx.conf compartilhado em deploy/.
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ .
# VITE_ envs de build (se houver) são passados via --build-arg.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Estágio 2: Nginx servindo o bundle e roteando para o backend.
FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/finflow.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
