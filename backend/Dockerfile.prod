# Imagem de produção do BACKEND FinFlow.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=finflow.settings

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x entrypoint.sh

# 1. Executa o collectstatic durante a COMPILAÇÃO da imagem (economiza ~30s no boot)
RUN SECRET_KEY=build_dummy_key python manage.py collectstatic --noinput --clear || true

# 2. Cria usuário não-root e ajusta permissões de pasta
RUN useradd --create-home appuser \
    && mkdir -p /app/media /app/staticfiles \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# 3. Otimizado para o plano Free (2 workers + 2 threads consome metade da memória RAM)
CMD exec gunicorn finflow.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2 --threads 2 --timeout 120